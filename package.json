{
  "name": "tabs-to-trails",
  "version": "0.1.0",
  "private": true,
  "description": "Turn your reading backlog into a walk.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server/dev.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/app.js --open",
    "walk": "tsx src/cli.ts",
    "test": "vitest",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && vitest run && vite build",
    "docs": "tsx scripts/build-docs.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@huggingface/transformers": "^3.8.1",
    "@mozilla/readability": "^0.6.0",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.13",
    "jsdom": "^30.1.2",
    "kokoro-js": "^1.2.1",
    "phonemizer": "^1.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.21.0": true,
    "esbuild@0.28.2": true,
    "sharp": false,
    "protobufjs": false,
    "fsevents": false
  }
}
